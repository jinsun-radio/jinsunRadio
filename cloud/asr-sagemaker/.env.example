# 複製成 .env 使用（.env 已被 gitignore）。AWS 憑證走標準來源，不要寫在這裡。

# 部署區域。實測顯示網路延遲是端到端的大頭，長輩端在台灣就選東京。
AWS_DEFAULT_REGION=ap-northeast-1

# SageMaker 執行角色（必填，每個帳號名稱不同）。查法：
#   aws iam list-roles --query "Roles[?contains(RoleName,'SageMaker')].Arn" --output text
SAGEMAKER_ROLE_ARN=

# 以下都有預設值，通常不用改
# BUCKET=sagemaker-<region>-<account-id>
# PREFIX=breeze-asr-26
# ENDPOINT_NAME=breeze-asr-26
# INSTANCE_TYPE=ml.g4dn.xlarge
# ASR_COMPUTE_TYPE=float16          # CPU 機型要改成 int8，並把 ASR_DEVICE 設為 cpu
# ASR_DEVICE=cuda
