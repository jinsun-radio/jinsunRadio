# 語音 Agent server 設定（複製成 .env 使用；.env 已被 gitignore）

# ─── LLM Provider ────────────────────────────────────────────────────
# mock（離線，免金鑰）｜ apikey（XCC Gateway，預設）｜ bedrock（Amazon Bedrock）
# 社工後台可即時切換（寫 Supabase app_settings.llm_provider），這裡是預設值。
LLM_PROVIDER=apikey

# ─── apikey（XCC Gateway）────────────────────────────────────────────
LLM_API_BASE=https://llm-gateway.xcc.tw/v1
LLM_API_AUTH=x-bf-vk
LLM_API_KEY=                    # ← XCC PAT（sk-bf-...），機密勿 commit
LLM_API_MODEL=gpt-5.6-luna
LLM_API_FAST_MODEL=gpt-5.6-luna

# ─── Bedrock（AWS，切換用）───────────────────────────────────────────
AWS_REGION=us-west-2
# 方式 1：Bedrock API Key（ABSK 開頭的 bearer token，短期金鑰）
# AWS_BEARER_TOKEN_BEDROCK=
# 方式 2：IAM 長期憑證（不會過期，正式環境建議用 IAM role）
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# ⚠️ 這個帳號（012804034919）只授權兩個模型，且 **裸 model id 一律 ResourceNotFound，
#    必須帶 us. 前綴**。已實測可用的只有下面這兩個；Sonnet 4.5／Opus 5／Sonnet 5
#    都是 AccessDenied（帳號層級 entitlement，換金鑰換區域都沒用）。
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_FAST_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_GATEWAY=standard

# ─── 資料層：兩套環境二選一 ──────────────────────────────────────────
# supabase（預設）＝現有環境；aurora＝AWS 平行環境（見 cloud/prototype/src/db.js）。
# 兩套**不共用資料庫**，理由見 cloud/aws/README.md。
DB_BACKEND=supabase

# ─── Supabase（DB_BACKEND=supabase 時）───────────────────────────────
# 填 secret key 才會真的寫派遣單、觸發三端；不填則 dry-run。
SUPABASE_URL=https://ykfxmoubynnbhnburawl.supabase.co
SUPABASE_SECRET_KEY=            # ← sb_secret_...，機密勿 commit

# ─── Aurora（DB_BACKEND=aurora 時）──────────────────────────────────
# 走 Data API，不必進 VPC、不必管連線池；密碼由 RDS 託管在 Secrets Manager。
# AURORA_CLUSTER_ARN=arn:aws:rds:us-west-2:012804034919:cluster:jinsun-aurora
# AURORA_SECRET_ARN=
# AURORA_DB_NAME=jinsun

# ─── AWS 三端資料 API（jinsun-data Lambda 用）────────────────────────
# COGNITO_POOL_ID=
# COGNITO_CLIENT_ID=
# PROOFS_BUCKET=jinsun-proofs        # 結案證明照片（presigned PUT）

# ─── MQTT 下行（server → 裝置）──────────────────────────────────────
# 本機開發：內嵌 aedes broker（預設 1883）
MQTT_PORT=1883
# 部署到 AWS/Render（只開 HTTPS）：改走外部 broker client
# MQTT_URL=mqtts://mqttgo.io:8883

# ─── 其他 ────────────────────────────────────────────────────────────
TRAVEL_STEPS=20
TRAVEL_STEP_MS=3000
APPROACH_METERS=250
ARRIVE_METERS=60
SIM_PATH=/__sim-4f9a2c
PORT=8787
