// 複製成同資料夾的 secrets.h（已在 .gitignore，不會進版控）後填入實際值。
// HUB-8735-Ultra-ASR-TTS.ino 會用 __has_include 自動帶入；沒有這個檔也編得過，
// 但用的是 .ino 裡的佔位符 —— 連不上 WiFi、ASR 會 401、AWS IoT 不會連。
//
// ⚠️ 這個檔會含裝置私鑰。不要 commit、不要貼進聊天視窗、不要放雲端硬碟。

#pragma once

// ===== WiFi =====
#define SECRET_WIFI_SSID "your-ssid"
#define SECRET_WIFI_PASS "your-password"

// ===== 雲端 ASR（XCC Gateway，兩套環境共用）=====
// 認的是 x-bf-vk 標頭，不是 Authorization: Bearer（送錯會整個掛住不回應）。
#define SECRET_ASR_API_KEY "sk-bf-xxxxxxxxxxxxxxxx"

// ===== AWS IoT 裝置憑證（只有 BACKEND_AWS=1 需要）=====
// 產生方式（私鑰無法從 AWS 取回，遺失就重簽一組，成本只有三個指令）。
// 指令包在 block 註解裡：shell 的行尾 \ 在 // 註解中會把下一行一起接進註解
// （-Wcomment），改回 // 每次編譯都會警告。
/*
  THING=JS-0001
  aws iot create-keys-and-certificate --set-as-active \
    --certificate-pem-outfile device.cert.pem \
    --private-key-outfile device.key.pem \
    --public-key-outfile device.public.pem \
    --query certificateArn --output text > cert.arn
  aws iot attach-policy --policy-name JinsunDevicePolicy --target "$(cat cert.arn)"
  aws iot attach-thing-principal --thing-name "$THING" --principal "$(cat cert.arn)"
*/
//
// 貼進來的方式：每行前後加引號、行尾補 \n。可以用這個指令直接產生：
//   awk '{printf "    \"%s\\n\"\n", $0}' device.cert.pem
//
// ⚠️ 憑證要 attach 到與 .ino 裡 device_serial 同名的 Thing。名字對不上時
//    AWS IoT 不會回錯誤碼，而是直接切斷連線 —— 症狀長得像「網路不穩」。
// ⚠️ 重簽憑證後，記得把 .ino 裡 setup() 的 tv.tv_sec 更新成 `date +%s`：
//    板子沒有 RTC，時鐘若早於新憑證的 notBefore，新憑證反而握不了手。

#define SECRET_AWS_DEVICE_CERT \
    "-----BEGIN CERTIFICATE-----\n" \
    "...device.cert.pem 的每一行...\n" \
    "-----END CERTIFICATE-----\n"

#define SECRET_AWS_DEVICE_KEY \
    "-----BEGIN RSA PRIVATE KEY-----\n" \
    "...device.key.pem 的每一行...\n" \
    "-----END RSA PRIVATE KEY-----\n"
